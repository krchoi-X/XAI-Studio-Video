{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xai-studio.local/schemas/video-intent-contract-v1.schema.json",
  "title": "XAI Studio Video Intent Contract v1",
  "type": "object",
  "required": ["schema_version", "contract_id", "status", "source", "context", "locked", "creative_envelope", "feasibility", "unresolved", "approval"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_id": {"type": "string", "pattern": "^intent_[A-Za-z0-9_-]+$"},
    "status": {"enum": ["draft", "approved", "superseded"]},
    "source": {
      "type": "object",
      "required": ["storyboard_id", "revision", "sha256"],
      "properties": {
        "storyboard_id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": ["user_goal", "viewer_should_understand", "viewer_should_feel", "shot_purpose", "rationale"],
      "properties": {
        "user_goal": {"type": "string", "minLength": 1},
        "viewer_should_understand": {"type": "string", "minLength": 1},
        "viewer_should_feel": {"type": "string", "minLength": 1},
        "shot_purpose": {"type": "string", "minLength": 1},
        "rationale": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "locked": {"$ref": "#/$defs/locked"},
    "creative_envelope": {
      "type": "object",
      "required": ["level", "allowed", "forbidden"],
      "properties": {
        "level": {"enum": ["L0", "L1", "L2", "L3"]},
        "allowed": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "forbidden": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}
      },
      "additionalProperties": false
    },
    "feasibility": {
      "type": "object",
      "required": ["decision", "rationale"],
      "properties": {
        "decision": {"enum": ["SHOW", "SPLIT", "IMPLY", "OMIT", "INSERT", "HIDE_TRANSITION", "CONTROL"]},
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "unresolved": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "approval": {
      "type": "object",
      "required": ["approved_by", "approved_at"],
      "properties": {
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "locked": {
      "type": "object",
      "required": ["ordered_events", "gaze", "screen_direction", "camera", "final_state", "omitted_events", "forbidden_additions"],
      "properties": {
        "ordered_events": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "gaze": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "screen_direction": {"type": "string", "minLength": 1},
        "camera": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "final_state": {"type": "string", "minLength": 1},
        "omitted_events": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "forbidden_additions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
