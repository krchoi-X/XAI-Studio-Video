{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xai-studio.local/schemas/character-pack-job-v1.schema.json",
  "title": "Character Pack durable job",
  "type": "object",
  "required": [
    "schema_version", "kind", "job_id", "character_id", "status", "requested_by",
    "created_at", "updated_at", "dna", "master_face", "engine_policy", "slots"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "character_pack_job"},
    "job_id": {"type": "string", "pattern": "^cpj-[A-Za-z0-9._-]+$"},
    "character_id": {"type": "string", "pattern": "^ch-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "status": {
      "enum": ["draft", "master_face_required", "ready", "generating", "needs_review", "partially_reviewed", "ready_for_pack_approval", "approved", "failed"]
    },
    "requested_by": {"enum": ["codex", "hermes", "web", "grok", "claude", "user"]},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "dna": {"$ref": "#/$defs/dnaBinding"},
    "master_face": {"$ref": "#/$defs/masterBinding"},
    "engine_policy": {
      "type": "object",
      "required": ["face_default", "body_default", "allowed", "fallback"],
      "properties": {
        "face_default": {"enum": ["qwen21", "krea2"]},
        "body_default": {"const": "krea2"},
        "allowed": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["qwen21", "krea2"]}
        },
        "fallback": {"const": "none"}
      },
      "additionalProperties": false
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/slotState"}
    }
  },
  "$defs": {
    "dnaBinding": {
      "type": "object",
      "required": ["version", "stable_dna_sha256"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "stable_dna_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "masterBinding": {
      "type": "object",
      "required": ["asset_id", "path", "sha256", "byte_count", "approval_id"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_count": {"type": "integer", "minimum": 1},
        "approval_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "slotState": {
      "type": "object",
      "required": ["slot_id", "stage", "required", "status", "attempts"],
      "properties": {
        "slot_id": {"$ref": "#/$defs/slotId"},
        "stage": {"enum": ["face", "body"]},
        "required": {"type": "boolean"},
        "status": {"enum": ["pending", "queued", "running", "needs_review", "selected", "rejected", "failed"]},
        "attempts": {"type": "integer", "minimum": 0},
        "last_error": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "slotId": {
      "enum": [
        "face_front", "face_left30", "face_right30", "face_left90", "face_right90",
        "body_front", "body_three_quarter", "body_side", "body_back"
      ]
    }
  },
  "additionalProperties": false
}

