{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xai-studio.local/schemas/renderer-job-request-v1.schema.json",
  "title": "XAI Studio Renderer Job Request v1",
  "type": "object",
  "required": ["schema_version", "job_id", "request_id", "stage", "character_ids", "reference_asset_ids", "prompt_strategy", "immutable_constraints", "engines", "count", "prompt_trace"],
  "properties": {
    "schema_version": {"const": 1},
    "job_id": {"type": "string", "pattern": "^job_[A-Za-z0-9_-]+$"},
    "request_id": {"type": "string", "pattern": "^req_[A-Za-z0-9_-]+$"},
    "storyboard_id": {"type": ["string", "null"]},
    "shot_id": {"type": ["string", "null"]},
    "stage": {"enum": ["sample", "final"]},
    "character_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "reference_asset_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "prompt_strategy": {"enum": ["strict_translation", "creative_expansion", "exact"]},
    "raw_user_prompt": {"type": "string"},
    "scene_spec": {"type": "object"},
    "immutable_constraints": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}},
    "engines": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "count": {"type": "integer", "minimum": 1, "maximum": 10},
    "prompt_trace": {"$ref": "#/$defs/promptTrace"}
  },
  "$defs": {
    "promptTrace": {
      "type": "object",
      "required": ["raw_user_prompt", "after_character_dna_merge", "after_constraint_validation", "final_prompt_sent_to_image_engine"],
      "properties": {
        "raw_user_prompt": {"type": "string"},
        "structured_scene_spec": {"type": "object"},
        "after_character_dna_merge": {"type": "string"},
        "after_constraint_validation": {"type": "object"},
        "after_scene_style_expansion": {"type": ["string", "null"]},
        "final_prompt_sent_to_hermes": {"type": ["string", "null"]},
        "final_prompt_sent_to_image_engine": {"type": "string"},
        "suppressed_stable_dna_fields": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
