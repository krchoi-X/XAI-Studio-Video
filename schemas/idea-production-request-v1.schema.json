{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xai-studio.local/schemas/idea-production-request-v1.schema.json",
  "title": "XAI Studio Idea Production Request v1",
  "type": "object",
  "required": ["schema_version", "request_id", "action", "idea", "character_ids", "candidate_count", "constraints", "reference_asset_ids"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^req_[A-Za-z0-9_-]+$"},
    "action": {"enum": ["create_storyboards"]},
    "idea": {"type": "string", "minLength": 3, "maxLength": 10000},
    "character_ids": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "pattern": "^ch-[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "candidate_count": {"type": "integer", "minimum": 2, "maximum": 3},
    "mode": {"enum": ["strict_translation", "creative_expansion", "exact"], "default": "creative_expansion"},
    "constraints": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}},
    "reference_asset_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "output_intent": {"enum": ["image", "video", "mixed"], "default": "image"}
  },
  "additionalProperties": false
}
