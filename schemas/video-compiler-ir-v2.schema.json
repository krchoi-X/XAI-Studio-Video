{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xai-studio.local/schemas/video-compiler-ir-v2.schema.json",
  "title": "XAI Studio Video Compiler Intermediate v2",
  "type": "object",
  "required": ["schema_version", "source_contract_id", "source_contract_sha256", "compiler", "compiler_version", "prompt_template_version", "target_model", "locked", "creative_choices"],
  "properties": {
    "schema_version": {"const": 2},
    "source_contract_id": {"type": "string", "pattern": "^intent_[A-Za-z0-9_-]+$"},
    "source_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compiler": {"type": "string", "minLength": 1},
    "compiler_version": {"type": "string", "minLength": 1},
    "prompt_template_version": {"enum": ["intent-prompt-v1", "h3-ref2va-v1", "h3-fl2va-v1"]},
    "target_model": {"type": "string", "minLength": 1},
    "locked": {
      "type": "object",
      "required": ["ordered_events", "gaze", "screen_direction", "camera", "final_state", "omitted_events", "forbidden_additions", "prompt_segments"],
      "properties": {
        "ordered_events": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "gaze": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "screen_direction": {"type": "string", "minLength": 1},
        "camera": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "final_state": {"type": "string", "minLength": 1},
        "omitted_events": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "forbidden_additions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "prompt_segments": {
          "type": "object",
          "required": ["subject_definition", "scene_definition", "event_lines", "gaze_line", "direction_line", "camera_line", "final_state_line", "omission_line"],
          "properties": {
            "subject_definition": {"type": "string", "minLength": 1},
            "scene_definition": {"type": "string", "minLength": 1},
            "event_lines": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
            "gaze_line": {"type": "string", "minLength": 1},
            "direction_line": {"type": "string", "minLength": 1},
            "camera_line": {"type": "string", "minLength": 1},
            "final_state_line": {"type": "string", "minLength": 1},
            "omission_line": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "engine_prompt_profiles": {
          "type": "object",
          "properties": {
            "h3_ref2va_v1": {"$ref": "#/$defs/h3_ref2va_profile"},
            "h3_fl2va_v1": {"$ref": "#/$defs/h3_fl2va_profile"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "creative_choices": {"type": "object"}
  },
  "$defs": {
    "h3_ref2va_profile": {
      "type": "object",
      "required": ["subject_definitions", "summary", "retention_analysis", "detailed_description", "overall_soundscape", "non_diegetic_music"],
      "properties": {
        "subject_definitions": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "retention_analysis": {"type": "string", "minLength": 1},
        "detailed_description": {"type": "string", "minLength": 1},
        "overall_soundscape": {"type": "string", "minLength": 1},
        "non_diegetic_music": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "h3_fl2va_profile": {
      "type": "object",
      "required": ["integrated_multimodal_description", "overall_soundscape", "non_diegetic_music"],
      "properties": {
        "integrated_multimodal_description": {"type": "string", "minLength": 1},
        "overall_soundscape": {"type": "string", "minLength": 1},
        "non_diegetic_music": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
