{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xai-studio.local/schemas/production-job-result-v1.schema.json",
  "title": "XAI Studio Production Job Result v1",
  "type": "object",
  "required": ["schema_version", "job_id", "request_id", "status", "progress", "result_session_id", "asset_ids", "errors"],
  "properties": {
    "schema_version": {"const": 1},
    "job_id": {"type": "string", "pattern": "^job_[A-Za-z0-9_-]+$"},
    "request_id": {"type": "string", "pattern": "^req_[A-Za-z0-9_-]+$"},
    "status": {"enum": ["queued", "running", "needs_user_choice", "completed", "failed", "interrupted"]},
    "progress": {
      "type": "object",
      "required": ["completed", "failed", "total"],
      "properties": {"completed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0}, "message": {"type": ["string", "null"]}},
      "additionalProperties": false
    },
    "result_session_id": {"type": ["string", "null"]},
    "asset_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
