{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xai-studio.local/schemas/video-compiler-ir-v1.schema.json",
  "title": "XAI Studio Video Compiler Intermediate v1",
  "type": "object",
  "required": ["schema_version", "source_contract_id", "source_contract_sha256", "compiler", "compiler_version", "target_model", "locked", "creative_choices"],
  "properties": {
    "schema_version": {"const": 1},
    "source_contract_id": {"type": "string", "pattern": "^intent_[A-Za-z0-9_-]+$"},
    "source_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compiler": {"type": "string", "minLength": 1},
    "compiler_version": {"type": "string", "minLength": 1},
    "target_model": {"type": "string", "minLength": 1},
    "locked": {"type": "object", "required": ["ordered_events", "gaze", "screen_direction", "camera", "final_state", "omitted_events", "forbidden_additions"], "properties": {"ordered_events": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}, "gaze": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}, "screen_direction": {"type": "string", "minLength": 1}, "camera": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}, "final_state": {"type": "string", "minLength": 1}, "omitted_events": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}, "forbidden_additions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}}, "additionalProperties": false},
    "creative_choices": {"type": "object"}
  },
  "additionalProperties": false
}
