{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xai-studio.local/schemas/reference-transformation-request-v2.schema.json",
  "title": "Reference Transformation Request v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "character_id", "reference", "operator_request", "operations", "requested_preserve", "requested_strategy", "engine_policy", "count"],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "reference_transformation"},
    "variation_id": {"type": "string", "minLength": 1},
    "character_id": {"type": "string", "minLength": 1},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "byte_count": {"type": "integer", "minimum": 1}
      }
    },
    "operator_request": {"type": "string", "minLength": 3, "maxLength": 4000},
    "operations": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "instruction", "strength"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["face_geometry", "facial_feature", "expression", "pose", "hand_gesture", "hair", "wardrobe", "background", "lighting", "camera", "framing"]},
          "instruction": {"type": "string", "minLength": 1, "maxLength": 1000},
          "strength": {"enum": ["subtle", "moderate", "exploratory"]}
        }
      }
    },
    "requested_preserve": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "requested_strategy": {"enum": ["auto", "identity_edit", "recompose_with_reference", "staged"]},
    "engine_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["required_capability", "preferred_engine", "allow_text_fallback"],
      "properties": {
        "required_capability": {"const": "reference_image_edit"},
        "preferred_engine": {"type": "string", "minLength": 1},
        "allow_text_fallback": {"const": false}
      }
    },
    "count": {"type": "integer", "minimum": 1, "maximum": 8}
  }
}
